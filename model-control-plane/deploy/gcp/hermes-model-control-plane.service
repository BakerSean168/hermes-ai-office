[Unit]
Description=Pixel Agent V4 Control Plane (GCP execution host)
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/dev/projects/pixel-agents
ExecStart=/usr/bin/node model-control-plane/dist/main.js
ExecStartPre=/usr/bin/test -f /home/dev/projects/pixel-agents/model-control-plane/dist/main.js
EnvironmentFile=/srv/hermes-personal/secrets/model-control-plane-v3.env
EnvironmentFile=/srv/hermes-personal/secrets/openhands-v3.env
Environment=NODE_ENV=production
Environment=MODEL_CP_OPENHANDS_URL=http://127.0.0.1:18000
Environment=MODEL_CP_SUPERVISOR_MODEL=gpt-5.6-luna
Environment=MODEL_CP_SUPERVISOR_RUNTIME_ENABLED=true
Environment=MODEL_CP_SUPERVISOR_POLL_MS=5000
Environment=MODEL_CP_HOST=127.0.0.1
Environment=MODEL_CP_PORT=8320
Environment=MODEL_CP_DB=/srv/hermes-personal/data/model-control-plane/pixel-v4.sqlite
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/hermes-personal/data/model-control-plane

[Install]
WantedBy=multi-user.target

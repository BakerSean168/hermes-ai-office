[Unit]
Description=Hermes Pixel Agent V4 Durable Coding Control Plane
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/dev/projects/pixel-agents
Environment=NODE_ENV=production
Environment=MODEL_CP_HOST=127.0.0.1
Environment=MODEL_CP_PORT=8320
Environment=MODEL_CP_DB=/srv/hermes-personal/data/model-control-plane/pixel-v4.sqlite
Environment=MODEL_CP_OPENHANDS_URL=http://127.0.0.1:18000
Environment=MODEL_CP_SUPERVISOR_MODEL=gpt-5.6-sol
Environment=MODEL_CP_SUPERVISOR_RUNTIME_ENABLED=true
Environment=MODEL_CP_SUPERVISOR_POLL_MS=5000
Environment=MODEL_CP_EXECUTION_RUNTIME_ENABLED=true
Environment=MODEL_CP_AUTOMATION_RUNTIME_ENABLED=true
Environment=MODEL_CP_AUTOMATION_POLL_MS=5000
Environment=MODEL_CP_V4_RESOURCE_SELECTOR_ENABLED=true
Environment=MODEL_CP_V4_SINGLE_ACTIVE_PLAN_ENABLED=true
Environment=MODEL_CP_V4_LITERAL_WORKTREES_ENABLED=true
Environment=MODEL_CP_V4_LITERAL_WORKTREE_PROJECTS=bodysense
Environment=MODEL_CP_V4_MAX_PARALLEL_WORK_ITEMS=2
Environment=MODEL_CP_V4_RESOURCE_REFRESH_MS=60000
Environment=MODEL_CP_V4_BUSINESS_RESOURCE_ENABLED=true
Environment=MODEL_CP_V4_ANTIGRAVITY_RESOURCE_ENABLED=true
Environment=MODEL_CP_V4_ANTIGRAVITY_PROJECTS=digital-biome
Environment=MODEL_CP_V4_ANTIGRAVITY_HOME=/home/dev
Environment=MODEL_CP_V4_ANTIGRAVITY_BIN=/home/dev/.local/bin/agy
Environment=MODEL_CP_V4_ANTIGRAVITY_UID=1001
Environment=MODEL_CP_V4_ANTIGRAVITY_GID=1002
Environment=MODEL_CP_V4_ANTIGRAVITY_USER=dev
Environment=MODEL_CP_V4_ANTIGRAVITY_PRINT_TIMEOUT=20m
Environment=MODEL_CP_V4_ANTIGRAVITY_STATE_ROOT=/srv/hermes-personal/data/model-control-plane/antigravity-v4
Environment=MODEL_CP_V4_ANTIGRAVITY_SANDBOX_WRAPPER=/home/dev/projects/pixel-agents/model-control-plane/scripts/run-antigravity-sandbox.sh
Environment=MODEL_CP_V4_ANTIGRAVITY_SYSTEMD_UNIT=hermes-antigravity-v4@%i.service
Environment=MODEL_CP_V4_AUTOMATION_PROJECTS=memoflow,digital-biome,bodysense
Environment=MODEL_CP_V4_ALLOWED_REPOSITORY_ROOTS=/home/dev/projects
Environment=MODEL_CP_V4_WORKSPACE_HOST_ROOT=/opt/data/hermes-ai-office-v3/workspaces
Environment=MODEL_CP_V4_WORKSPACE_EXECUTION_ROOT=/workspace
Environment=MODEL_CP_V4_WORKSPACE_UID=10001
Environment=MODEL_CP_V4_WORKSPACE_GID=10001
Environment=MODEL_CP_V4_HOST_CACHE_STATE_FILE=/srv/hermes-personal/data/model-control-plane/host-cache-maintenance.json
Environment=MODEL_CP_AGENT_HARNESS_CTL=/home/dev/projects/agent-harness/bin/harnessctl.py
Environment=MODEL_CP_V4_MAX_IMPLEMENTATION_ATTEMPTS=3
Environment=MODEL_CP_V4_MAX_REVIEW_ATTEMPTS=4
Environment=MODEL_CP_V4_MAX_REPAIR_CYCLES=3
EnvironmentFile=/srv/hermes-personal/secrets/model-control-plane-v3.env
EnvironmentFile=/srv/hermes-personal/secrets/openhands-v3.env
ExecStart=/usr/bin/node model-control-plane/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
ReadWritePaths=/srv/hermes-personal/data/model-control-plane
ReadWritePaths=/opt/data/hermes-ai-office-v3/workspaces
ReadWritePaths=/home/dev/projects/memoflow-platform-1003
ReadWritePaths=/home/dev/projects/memoflow/.git
ReadWritePaths=/home/dev/projects/digital-biome
ReadWritePaths=/home/dev/projects/bodysense

[Install]
WantedBy=multi-user.target

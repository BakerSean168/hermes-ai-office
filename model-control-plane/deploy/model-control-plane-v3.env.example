# Host-specific, non-secret runtime metadata for the V3 control plane.
# Copy to /srv/hermes-personal/secrets/model-control-plane-v3.env and keep the
# real deployment hostname outside Git.
MODEL_CP_V3_LITELLM_ADMIN_URL=https://host.example.invalid:10446/ui/

# Optional provider-native Antigravity backend. The backend remains unavailable
# until its names are explicitly added to MODEL_CP_V3_ENABLED_BACKENDS.
MODEL_CP_V3_ANTIGRAVITY_HOME=/home/dev
MODEL_CP_V3_ANTIGRAVITY_BIN=/home/dev/.local/bin/agy
MODEL_CP_V3_ANTIGRAVITY_USER=dev
MODEL_CP_V3_ANTIGRAVITY_UID=1001
MODEL_CP_V3_ANTIGRAVITY_GID=1002
MODEL_CP_V3_ANTIGRAVITY_PRINT_TIMEOUT=20m
